# Copy to .env and fill in local SQL Server credentials.
DB_USERNAME=sa
DB_PASSWORD=replace-with-your-local-password
DB_HOST=localhost
DB_PORT=1433
# Tên database (mặc định HotelManagement_SBA). Chỉ cần tạo database rỗng, Flyway tự dựng bảng và dữ liệu demo.
DB_NAME=HotelManagement_SBA

# JWT secret Base64 (>= 32 byte). Tao bang: openssl rand -base64 64
# De trong: app tu sinh khoa tam, phai dang nhap lai sau moi lan restart.
JWT_SECRET_BASE64=

# Module B - Rooms: khach san phai ton tai va active. Seed demo co hotel_id = 1.
INVENTORY_DEFAULT_HOTEL_ID=1
# Bat anh loai phong va ghi chu. Database phai co rooms.notes va room_type_images
# theo schema hoan chinh cua nhom truoc khi khoi dong backend JPA.
INVENTORY_EXTENSIONS_ENABLED=true

# Upload anh: tuy chon, khong can them khi chay local voi cau hinh mac dinh.
# Mac dinh luu tai <thu muc nguoi dung>/.hotel-management/room-images, ngoai project.
# Neu doi thu muc tren Windows, dung dau / trong duong dan:
# INVENTORY_IMAGE_DIRECTORY=D:/HotelManagementData/room-images
# Neu backend dung host/port khac localhost:8080, dat URL public tuong ung:
# INVENTORY_IMAGE_BASE_URL=http://localhost:8080/api/inventory/public/images

# Dat coc QR payOS. Dung kenh rieng cho database va giu offset co dinh.
BOOKING_PAYOS_ENABLED=false
BOOKING_PAYOS_CLIENT_ID=
BOOKING_PAYOS_API_KEY=
BOOKING_PAYOS_CHECKSUM_KEY=
BOOKING_PAYOS_FRONTEND_URL=http://127.0.0.1:5173
BOOKING_PAYOS_ORDER_OFFSET=0
BOOKING_PAYOS_RECEIVER_BIN=
BOOKING_PAYOS_RECEIVER_ACCOUNT=
BOOKING_PAYOS_RECEIVER_NAME=

# Tuy chon (mac dinh 900 giay / 7 ngay)
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Gui ma OTP khi quen mat khau. De trong MAIL_HOST thi ma chi duoc ghi vao log cua backend (dung khi dev).
# Gmail: bat xac thuc 2 buoc roi tao "Mat khau ung dung" (App password); khong dung mat khau dang nhap Gmail.
MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
# OTP_TTL_MINUTES=10

# Chỉ khi deploy: địa chỉ nghe (0.0.0.0 để nhận kết nối từ ngoài) và mật khẩu admin khởi tạo (>= 8 ký tự).
# SERVER_ADDRESS=0.0.0.0
# ADMIN_BOOTSTRAP_PASSWORD=
# INVENTORY_IMAGE_BASE_URL=https://<backend>/api/inventory/public/images
# Brevo (khi deploy): MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=2525, MAIL_STARTTLS=true,
# MAIL_USERNAME=<email Brevo>, MAIL_PASSWORD=<SMTP key>, MAIL_FROM=<sender đã xác minh>
