# Copy to .env and fill in local SQL Server credentials.
DB_USERNAME=sa
DB_PASSWORD=replace-with-your-local-password
DB_HOST=localhost
DB_PORT=1433

# JWT secret Base64 (>= 32 byte). Tao bang: openssl rand -base64 64
# De trong: app tu sinh khoa tam, phai dang nhap lai sau moi lan restart.
JWT_SECRET_BASE64=
# Khach san dung cho trang tim phong cong khai (Module B). Seed demo co hotel_id = 1.
INVENTORY_DEFAULT_HOTEL_ID=1

# Tuy chon (mac dinh 900 giay / 7 ngay)
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800
# CORS_ALLOWED_ORIGINS=http://localhost:5173
