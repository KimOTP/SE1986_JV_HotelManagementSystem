# api (khuyến nghị): đăng nhập bằng backend thật (JWT); mock: dữ liệu giả trên trình duyệt.
# Các API Module E bắt buộc JWT nên cần chế độ api.
VITE_AUTH_DATA_SOURCE=api
# mock (mặc định) hoặc api
VITE_ROOMS_DATA_SOURCE=mock
# Chỉ dùng khi VITE_ROOMS_DATA_SOURCE=api; không đặt secret trong VITE_*
VITE_API_BASE_URL=http://localhost:8080/api
