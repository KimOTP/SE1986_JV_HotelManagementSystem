# api (khuyến nghị): đăng nhập bằng backend thật (JWT); mock: dữ liệu giả trên trình duyệt.
# Các API Module E bắt buộc JWT nên cần chế độ api.
VITE_AUTH_DATA_SOURCE=api
# api (khuyến nghị): dữ liệu phòng từ backend; mock: dữ liệu giả trên trình duyệt.
VITE_ROOMS_DATA_SOURCE=api
# Địa chỉ backend; không đặt secret trong VITE_*
VITE_API_BASE_URL=http://localhost:8080/api
